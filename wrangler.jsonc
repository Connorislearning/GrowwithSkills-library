{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skill-library",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"build": { "command": "node scripts/bundle-skills.mjs" },
	"workers_dev": true,
	"observability": { "enabled": true }
}
